{
  "entities": {
    "Comment": {
      "title": "Social comment or news post",
      "description": "An individual social media comment, forum post or news article about Jordan processed via NLP.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "handle": { "type": "string" },
        "platform": { "type": "string", "enum": ["X", "Facebook", "Instagram", "YouTube", "TikTok", "Threads", "Reddit", "LinkedIn", "Rumble", "Other"] },
        "text": { "type": "string" },
        "cleanedText": { "type": "string" },
        "language": { "type": "string", "enum": ["ar", "en"] },
        "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
        "sentimentScore": { "type": "number" },
        "topic": { "type": "string" },
        "themeId": { "type": "string" },
        "codebookVersion": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "likeCount": { "type": "number" },
        "replyCount": { "type": "number" },
        "likes": { "type": "number" },
        "shares": { "type": "number" },
        "tokens": { "type": "array", "items": { "type": "string" } },
        "namedEntities": { "type": "array", "items": { "type": "string" } },
        "classifiedEntities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "nameEn": { "type": "string" },
              "type": { "type": "string", "enum": ["person", "organization", "location"] },
              "confidence": { "type": "number" },
              "salience": { "type": "number" },
              "sentiment": { "type": "string" },
              "sentimentScore": { "type": "number" }
            }
          }
        },
        "keyPhrases": { "type": "array", "items": { "type": "string" } },
        "governorate": { "type": "string" },
        "provenance": { "type": "object" }
      },
      "required": ["id", "author", "handle", "platform", "text", "cleanedText", "language", "sentiment", "sentimentScore", "topic", "timestamp"]
    },
    "Event": {
      "title": "National Event or Policy Announcement",
      "description": "An important national event, royal decree or policy announcement in Jordan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "label": { "type": "string" },
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "icon": { "type": "string" },
        "sentimentEffect": { "type": "string", "enum": ["positive", "neutral", "negative"] }
      },
      "required": ["id", "date", "label", "title", "desc", "icon", "sentimentEffect"]
    },
    "MonitoredCategory": {
      "title": "Monitored social accounts category",
      "description": "A set of social media handles tracked for a specific category of Jordanian public figures, news, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "handles": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["handles"]
    },
    "RecognizedEntityInsight": {
      "title": "Recognized Named Entity & Topic Intelligence Record",
      "description": "Aggregated named entity metric linked with Jordan policy sectors, sentiment, and co-occurrences.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "type": { "type": "string", "enum": ["person", "organization", "location"] },
        "totalMentions": { "type": "number" },
        "avgSentiment": { "type": "number" },
        "positiveCount": { "type": "number" },
        "neutralCount": { "type": "number" },
        "negativeCount": { "type": "number" },
        "associatedThemes": { "type": "array" }
      },
      "required": ["id", "name", "type", "totalMentions", "avgSentiment"]
    }
  },
  "firestore": {
    "comments": {
      "schema": "Comment",
      "description": "Real-time collected comments and posts about Jordan."
    },
    "accounts": {
      "schema": "MonitoredCategory",
      "description": "Supervised social accounts monitored by crawlers compiled by categories."
    },
    "events": {
      "schema": "Event",
      "description": "Major national events and policy announcements rendered as annotations."
    },
    "entities": {
      "schema": "RecognizedEntityInsight",
      "description": "Aggregated NER entities and policy sector correlations."
    }
  }
}
