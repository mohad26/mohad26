rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions for Path Variable Hardening and Auth Detection
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    // Comment Entity Validation Checker
    function isValidComment(c) {
      return c.keys().hasAll(['id', 'author', 'handle', 'platform', 'text', 'cleanedText', 'language', 'sentiment', 'sentimentScore', 'timestamp', 'provenance'])
        && c.id is string
        && c.id.size() <= 128
        && c.author is string
        && c.author.size() <= 256
        && c.handle is string
        && c.handle.size() <= 256
        && c.text is string
        && c.text.size() <= 10000
        && c.cleanedText is string
        && c.cleanedText.size() <= 10000
        && c.language is string
        && c.language.size() <= 16
        && c.sentiment in ['positive', 'neutral', 'negative']
        && c.sentimentScore is number
        && c.sentimentScore >= -1.1
        && c.sentimentScore <= 1.1
        && c.provenance is map
        && c.provenance.keys().hasAll(['sourceId', 'kind', 'fetchedAt', 'collectedLive'])
        && c.provenance.sourceId is string
        && c.provenance.sourceId.size() <= 64
        && c.provenance.kind is string
        && c.provenance.kind.size() <= 64
        && c.provenance.collectedLive is bool
        && (!('governorate' in c) || (c.governorate is string && c.governorate.size() <= 128))
        && (!('classifiedEntities' in c) || (c.classifiedEntities is list && c.classifiedEntities.size() <= 30));
    }

    // Account Category Validation Checker
    function isValidCategory(cat) {
      return cat.keys().hasAll(['handles'])
        && cat.handles is list
        && cat.handles.size() <= 200;
    }

    // Event Validation Checker
    function isValidEvent(evt) {
      return evt.keys().hasAll(['id', 'date', 'label', 'title', 'desc', 'icon', 'sentimentEffect'])
        && evt.id is string
        && evt.id.size() <= 128
        && evt.date is string
        && evt.date.size() <= 32
        && evt.label is string
        && evt.label.size() <= 128
        && evt.title is string
        && evt.title.size() <= 256
        && evt.desc is string
        && evt.desc.size() <= 4000
        && evt.icon is string
        && evt.icon.size() <= 16
        && evt.sentimentEffect in ['positive', 'neutral', 'negative'];
    }

    // Entity Insight Validation Checker
    function isValidEntityInsight(ent) {
      return ent.keys().hasAll(['id', 'name', 'type', 'totalMentions', 'avgSentiment'])
        && ent.id is string
        && ent.id.size() <= 128
        && ent.name is string
        && ent.name.size() <= 256
        && ent.type in ['person', 'organization', 'location']
        && ent.totalMentions is number
        && ent.avgSentiment is number;
    }

    // Rules for Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create, update: if isValidId(commentId) && isValidComment(incoming()) && incoming().id == commentId;
      allow delete: if false;
    }

    // Rules for Supervised Accounts Configuration collection
    match /accounts/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if false;
    }

    // Rules for Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId) && isValidEvent(incoming());
      allow delete: if false;
    }

    // Rules for Recognized Entity Insights Collection
    match /entities/{entityId} {
      allow read: if true;
      allow create, update: if isValidId(entityId) && isValidEntityInsight(incoming()) && incoming().id == entityId;
      allow delete: if false;
    }
  }
}
